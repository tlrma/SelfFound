# ============================================
# SLAF 프로젝트 .gitignore
# ============================================

# --------------------------------------------
# 환경변수 (절대 커밋 금지)
# --------------------------------------------
.env
.env.*
!.env.example
*.env
!example.env

# 비밀 키/인증서
*.pem
*.key
secrets/
credentials/

# --------------------------------------------
# Python (Django, 키오스크, CV)
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 가상환경
venv/
.venv/
env/
ENV/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
/static/

# Django migrations는 보통 커밋함 (주석 해제 시 무시)
# */migrations/*.py
# !*/migrations/__init__.py

# Celery
celerybeat-schedule
celerybeat.pid

# 패키지 빌드
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 테스트/커버리지
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/

# Jupyter
.ipynb_checkpoints
*.ipynb
!vision/*.ipynb

# --------------------------------------------
# Node.js (Vue 프론트엔드)
# --------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 빌드 결과
frontend/dist/
frontend/.nuxt/
frontend/.output/

# Vite
.vite/

# --------------------------------------------
# ROS 2
# --------------------------------------------
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
build/
install/
log/

# colcon
.colcon/

# --------------------------------------------
# AI/ML 큰 파일 (Git LFS 또는 별도 공유)
# --------------------------------------------
# YOLO 모델
*.pt
*.pth
*.onnx
*.engine
*.weights

# 학습 결과
runs/
wandb/
checkpoints/
vision/models/checkpoints/

# 데이터셋 (크기가 큼 - Google Drive로 공유)
vision/dataset/
vision/dataset_balanced/
vision/dataset_mini/
vision/data/
*.h5
*.hdf5

# --------------------------------------------
# 로봇/시뮬 관련 파일
# --------------------------------------------
# SLAM 맵 (큰 파일)
*.pgm
*.pbstream
!ros2_ws/src/*/maps/*.yaml

# 캘리브레이션 결과 (환경별로 다름)
calibration_result.yaml
camera_info.yaml

# Gazebo
.gazebo/

# RoboDK
*.rdk.bak

# --------------------------------------------
# 미디어/업로드
# --------------------------------------------
# 사용자 업로드 (분실물 사진 등)
backend/media/uploads/
uploads/

# 시연용 임시 영상
*.mp4
*.mov
*.avi
!docs/demo/*.mp4

# --------------------------------------------
# IDE / 에디터
# --------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json

# PyCharm / IntelliJ
.idea/
*.iml
*.iws

# Sublime
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# --------------------------------------------
# OS
# --------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# --------------------------------------------
# 기타
# --------------------------------------------
# 임시 파일
*.tmp
*.temp
*.bak
*.swp

# 로그
*.log
logs/

# 압축 파일 (보통 안 올림)
*.zip
*.tar
*.tar.gz
*.rar

# 개인 메모
TODO.md
NOTES.md
scratch/
playground/
