# ============================================
# SLAF 프로젝트 환경변수 예시
# ============================================
# 사용법:
#   1. 이 파일을 .env로 복사: cp .env.example .env
#   2. 본인 환경에 맞게 값 수정
#   3. .env 파일은 절대 커밋하지 말 것
# ============================================

# --------------------------------------------
# Django
# --------------------------------------------
DJANGO_SECRET_KEY=change-this-to-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --------------------------------------------
# Database (MySQL)
# --------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=slaf
DB_USER=slaf_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# --------------------------------------------
# Email (매칭 알림 발송)
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True
EMAIL_FROM=noreply@slaf.example.com

# --------------------------------------------
# Redis (Celery 브로커)
# --------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --------------------------------------------
# ROS / rosbridge
# --------------------------------------------
ROSBRIDGE_HOST=localhost
ROSBRIDGE_PORT=9090

# --------------------------------------------
# Dobot
# --------------------------------------------
DOBOT_IP=192.168.0.10
DOBOT_DASHBOARD_PORT=29999
DOBOT_FEEDBACK_PORT=30003

# --------------------------------------------
# TurtleBot
# --------------------------------------------
TURTLEBOT_NAMESPACE=tb3
ROS_DOMAIN_ID=30

# --------------------------------------------
# Vision / AI
# --------------------------------------------
YOLO_MODEL_PATH=vision/models/yolov8_lostitems.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
CAMERA_DEVICE=/dev/video0
CAMERA_CALIBRATION_PATH=vision/calibration/camera_params.yaml

# LLM API (매칭용, 사용 시)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --------------------------------------------
# 컨베이어
# --------------------------------------------
CONVEYOR_PORT=/dev/ttyUSB0
CONVEYOR_BAUDRATE=9600

# --------------------------------------------
# 시연 / 환경 분기
# --------------------------------------------
USE_SIM=true                    # true: Gazebo/RoboDK, false: 실기
DEMO_MODE=false                 # true면 만료 기간 단축 등 시연용 설정
EXPIRY_DAYS=30                  # 시연 시 1로 변경
ID_VERIFICATION_TTL_DAYS=7      # 신분증 검증 데이터 보관 기간

# --------------------------------------------
# 관리자
# --------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# --------------------------------------------
# Frontend (선택, Vue용)
# --------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
