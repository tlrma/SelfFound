<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="lost_and_found">

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <model name="environment">
      <static>1</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- 외벽 북쪽 -->
      <link name="wall_north">
        <pose>0 2.5 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>6 0.15 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>6 0.15 2.5</size></box></geometry>
          <material><script><name>Gazebo/White</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
      </link>

      <!-- 외벽 남쪽 -->
      <link name="wall_south">
        <pose>0 -2.5 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>6 0.15 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>6 0.15 2.5</size></box></geometry>
          <material><script><name>Gazebo/White</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
      </link>

      <!-- 서쪽 벽 위쪽 y=2.5~1.68 -->
      <link name="wall_west_top">
        <pose>-3 2.09 1.25 0 0 1.5708</pose>
        <collision name="col"><geometry><box><size>0.82 0.15 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.82 0.15 2.5</size></box></geometry>
          <material><script><name>Gazebo/White</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
      </link>

      <!-- 서쪽 벽 중간 y=0.92~-0.9 -->
      <link name="wall_west_mid">
        <pose>-3 0.01 1.25 0 0 1.5708</pose>
        <collision name="col"><geometry><box><size>1.82 0.15 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.82 0.15 2.5</size></box></geometry>
          <material><script><name>Gazebo/White</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
      </link>

      <!-- 서쪽 벽 아래쪽 y=-1.5~-2.5 -->
      <link name="wall_west_bot">
        <pose>-3 -2.0 1.25 0 0 1.5708</pose>
        <collision name="col"><geometry><box><size>1.0 0.15 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 0.15 2.5</size></box></geometry>
          <material><script><name>Gazebo/White</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
      </link>

      <!-- 외벽 동쪽 -->
      <link name="wall_east">
        <pose>3 0 1.25 0 0 1.5708</pose>
        <collision name="col"><geometry><box><size>5 0.15 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>5 0.15 2.5</size></box></geometry>
          <material><script><name>Gazebo/White</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
      </link>

      <!-- 컨베이어 벨트 (5배 크기) -->
      <link name="conveyor">
        <pose>-2.29 1.3 0.2 0 0 0</pose>
        <collision name="col"><geometry><box><size>1.425 0.765 0.4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.425 0.765 0.4</size></box></geometry>
          <material><script><name>Gazebo/DarkGrey</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
      </link>

      <!-- 작업대 -->
      <link name="worktable">
        <pose>-1.33 1.3 0.2 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.5 0.5 0.4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.4</size></box></geometry>
          <material><script><name>Gazebo/White</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
      </link>

      <!-- Dobot (박스로 표시) -->
      <link name="dobot">
        <pose>-0.83 1.3 0.3 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><script><name>Gazebo/Orange</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
      </link>

